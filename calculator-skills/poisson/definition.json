    {
      "chapter": "range",
      "spoken": "PDF takes one count. CDF adds every count between its two bounds.",
      "coach": "Include 3, 4, 5 and 6. The bounds themselves count.",
      "end": 45.58,
      "hold": 0.8,
      "keys": []
    },
    {
      "chapter": "range",
      "spoken": "Counts three, four, five and six together have probability about zero point five four four.",
      "coach": "Three through six: 0.544 to three significant figures.",
      "end": 53.17,
      "hold": 0.7,
      "keys": []
    },
