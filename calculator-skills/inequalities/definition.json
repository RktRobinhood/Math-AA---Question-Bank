    {
      "chapter": "test-intervals",
      "spoken": "At x equals minus three, f one is below f two. At x equals zero, it is above.",
      "coach": "At x = −3, f₁ = −1.25 < 0. At x = 0, f₁ = 4 > 0.",
      "end": 76.175,
      "hold": 1.65,
      "keys": []
    },
    {
      "chapter": "test-intervals",
      "spoken": "At x equals one point five, f one is below f two again. At x equals three, it is above.",
      "coach": "At x = 1.5, f₁ = −3.5 < 0. At x = 3, f₁ = 2.5 > 0.",
      "end": 84.855,
      "hold": 1.65,
      "keys": []
    },
    {
      "chapter": "solution",
      "spoken": "Include the equal points at negative two and two because the inequality includes equality. Leave x equals one out.",
      "coach": "Include the two equalities because the inequality includes equality. Still exclude x = 1.",
      "end": 94.582,
      "hold": 1.65,
      "keys": []
    },
    {
      "chapter": "solution",
      "spoken": "At the domain edge x equals minus four, f one is below f two, so include minus four too.",
      "coach": "At x = −4, f₁ = −2.4. The solution is [−4, −2] ∪ (1, 2].",
      "end": 103.227,
