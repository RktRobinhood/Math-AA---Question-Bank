  "route": "complex/index.html",
  "catalogueTitle": "Complex numbers: rectangular and polar",
  "playerHeading": "Complex numbers",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "complex/index.html"
  },
  "script": "lessons/CT20.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Use z equals negative eight plus fifteen times the imaginary unit. Set Angle to Degree and Real or Complex to Rectangular.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Type the real and imaginary coefficients. Press pi and choose the imaginary unit, not the letter i.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use the absolute-value command on negative eight plus fifteen i. Control and Enter give a decimal where needed. Modulus is distance.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Use the angle command on negative eight plus fifteen i. The point is in quadrant two; the principal angle is obtuse.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Open Document Settings again. Change Real or Complex to Polar. The number itself does not change.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Re-enter the same value. In Degree mode, the polar display has magnitude seventeen and angle one hundred and eighteen point zero seven two degrees. In Radian mode it uses exponential form.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The argument shown is principal. Only change the range if the question asks. Zero has no argument.",
      "watchCueId": "watch-07"
    }
  ],
