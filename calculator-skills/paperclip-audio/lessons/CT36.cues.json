  "spokenCues": [
    {
      "id": "watch-01",
      "text": "The possible outcomes are minus two, one and four. Their respective probabilities are zero point two five, zero point three five and zero point four zero.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "First add just the probabilities. A valid distribution gives a total of one.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Type the outcome, times , and its own probability. A negative outcome gives a negative contribution.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Join the three products with plus signs. Press Enter; do not simply average the outcomes.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The expectation is one point four five: a long-run average, not a value that must occur on any individual trial.",
      "watchCueId": "watch-05"
    }
  ],
