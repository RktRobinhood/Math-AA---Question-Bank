  "catalogueTitle": "Box plots, outliers and histograms",
  "playerHeading": "Box plots and outliers",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "boxplots/index.html"
  },
  "script": "lessons/CT30.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start in Data and Statistics with the numeric list reading on the horizontal axis.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu then one: Plot Type then two: Box Plot. It starts as a modified box plot.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Point at the box edges and the line inside. The first quartile is two. The median is four. The third quartile is six.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The interquartile range is six minus two, or four. Subtract one point five times this range from the first quartile, and add it to the third quartile.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The fences are minus four and twelve. These are calculated cutoffs, not necessarily data points.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "There is no observation at minus four. The left whisker stops at zero, the smallest value inside.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "By the mathematical rule, twelve is on the fence and stays in. thirteen is strictly beyond it.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "In Plot Properties, choose Extend Box Plot Whiskers. This makes a standard box plot.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "The whiskers now run from zero to thirteen. The quartiles stay the same; thirteen is not marked separately.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Choose Show Box Plot Outliers to return to the modified plot.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "Report the fence and the observed whisker separately.",
      "watchCueId": "watch-11"
    }
  ],
