  "route": "displacement-distance/index.html",
  "catalogueTitle": "Kinematics: displacement versus total distance",
  "playerHeading": "Displacement and total distance",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "displacement-distance/index.html"
  },
  "script": "lessons/CT53.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Enter three minus two x in Graphs. The calculator's x is time t, measured in seconds.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "For displacement, take one signed integral. Choose Menu then six: Analyze Graph then six: Integral.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Type zero and press Enter for the lower bound. Type four and press Enter for the upper bound.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The signed result is negative four metres. The cart finishes four metres behind its starting point.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The distance needs the reversal time. Choose Menu then six: Analyze Graph then one: Zero.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Move the cursor to either side of the crossing, confirming each bound with Enter.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Press Enter to mark the zero. Velocity is positive before one point five seconds and negative after it.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Repeat Integral from zero to one point five. This positive part is the forward travel.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "The forward piece is positive two point two five metres.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Repeat Integral from one point five to four. The second result is negative because motion was backward.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "The second signed piece is negative six point two five metres, so the cart travelled six point two five metres backward.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "Add magnitudes for distance. Taking the absolute value of the net result would lose the forward travel.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "If the graph only touches zero and stays on the same side, the cart stops but does not reverse. Try a fresh model.",
      "watchCueId": "watch-13"
    }
  ],
