  "spokenCues": [
    {
      "id": "watch-01",
      "text": "The allowed interval is minus two to three. The graph is already on the screen.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu, choose Analyze Graph, then Maximum.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Move to the left of the peak and press Enter. Then choose the upper bound just to its right.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The calculator marks the point negative one, four. That is a local peak, not yet the answer.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Both endpoints count because the interval is closed. Substitute minus two into the function.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Substitute three to check the other endpoint.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Compare the three heights. The right endpoint is highest.",
      "watchCueId": "watch-07"
    }
  ],
