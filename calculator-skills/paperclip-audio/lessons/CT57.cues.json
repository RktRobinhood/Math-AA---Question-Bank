  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Rotate the region from y equals one to y equals two x, with x from one to two inclusive, about the x axis. Each slice has a hole.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "The outer radius is two x and the inner radius is one. Enter pi outside the integral. Use a difference of squares, not the square of the gap.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "On Calculator, choose Menu then four: Calculus then two: Numerical Definite Integral.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Tab moves from the lower bound one to the upper bound two, then into the integrand.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter the square of two times x, minus one squared. The pi outside multiplies every slice. Tab to the differential, type x, then Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The solid has volume about twenty-six point one eight zero cubic units. For a disk touching the axis, the inner radius is zero.",
      "watchCueId": "watch-06"
    }
  ],
