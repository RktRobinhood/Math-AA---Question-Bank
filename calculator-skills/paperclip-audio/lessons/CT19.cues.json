  "id": "CT19",
  "route": "vectors/index.html",
  "catalogueTitle": "Vector arithmetic and angles",
  "playerHeading": "Dot product & angle",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "vectors/index.html"
  },
  "script": "lessons/CT19.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Find the dot product and angle for vector A, with components two, negative one, two, and vector B, with components one, two, negative two. The example is in degrees.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Type A, then Control and Templates to get the assignment symbol. Open Menu, then seven, one, one. Use one row and three columns.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Store B as another matrix with one row and three columns. Use the negative key for negative entries.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Choose Menu, then seven for Matrix and Vector, the letter C for Vector, then three for Dot Product. Enter A followed by a comma and B.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Use inverse cosine, not the reciprocal of cosine. Control and the divide key open a fraction. Put the dot product on top.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Below, use the norm of A times the norm of B. Open Menu, then seven, then seven for Norms, then one for Norm, to insert each norm.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The dot product is negative four. Both lengths are three, so cosine theta is negative four ninths. The negative cosine gives an obtuse angle.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The angle is about one hundred and sixteen point three eight eight degrees. This is one hundred and sixteen degrees to three significant figures. A zero-length vector has no direction.",
      "watchCueId": "watch-08"
    }
  ],
  "watch": {
    "timingBasis": "Runtime Watch seek-port scan at 75 ms with transitions refined to 1 ms; this is editorial/display clock, never measured speech. Very brief lights can be missed; authoredTape, where supplied, is authoritative.",
    "sliderEndAtExtractionMs": 53000,
    "captionCues": [
      {
        "id": "watch-01",
        "startMs": 0,
        "text": "Find the dot product and angle for a = [2, −1, 2] and b = [1, 2, −2]. The example is in degrees.",
        "endMs": 2600
      },
      {
        "id": "watch-02",
        "startMs": 2600,
        "text": "Type a, then Ctrl + templates for :=. Open Menu → 7 → 1 → 1. Use one row and three columns.",
        "endMs": 10300
      },
      {
        "id": "watch-03",
        "startMs": 10300,
        "text": "Store b as another 1 × 3 row. Use the (−) key for negative entries.",
        "endMs": 17300
      },
      {
        "id": "watch-04",
        "startMs": 17300,
        "text": "Choose Menu → 7: Matrix & Vector → C: Vector → 3: Dot Product. Enter a,b.",
        "endMs": 23500
      },
      {
        "id": "watch-05",
        "startMs": 23500,
        "text": "Use cos⁻¹, not 1/cos. Ctrl + ÷ opens a fraction. Put the dot product on top.",
        "endMs": 34000
      },
      {
        "id": "watch-06",
        "startMs": 34000,
        "text": "Below, use norm(a) × norm(b). Menu → 7 → 7: Norms → 1: Norm inserts each norm.",
        "endMs": 44000
      },
      {
        "id": "watch-07",
        "startMs": 44000,
        "text": "The dot product is −4. Both lengths are 3, so cos θ = −4/9. The negative cosine gives an obtuse angle.",
        "endMs": 48400
      },
      {
        "id": "watch-08",
        "startMs": 48400,
        "text": "The angle is about 116.388°. This is 116° to three significant figures. A zero-length vector has no direction.",
        "endMs": 53000
      }
    ],
