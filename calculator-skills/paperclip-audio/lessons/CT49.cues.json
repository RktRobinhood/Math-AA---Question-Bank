  "script": "lessons/CT49.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Estimate the mean of a normal population. The sample mean is forty and the sample size is thirty-six. First suppose we know the population standard deviation is six.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On a Calculator page, choose Menu then Statistics then Confidence Intervals then z Interval. Select Stats rather than Data.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter six for the population standard deviation, forty for the sample mean, thirty-six for the sample size, and zero point nine five for C Level. Enter a proportion, not ninety-five.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Read the lower and upper confidence bounds: about thirty-eight point zero four and forty-one point nine six. The margin of error is half the width, not an endpoint.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Now suppose six is only the sample standard deviation. Use t Interval with Stats. The distinction is whether the population standard deviation is known, not whether the sample size exceeds thirty.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "For t, enter the sample mean first and the sample standard deviation second. Keep the sample size at thirty-six and C Level at zero point nine five.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "About thirty-seven point nine seven to forty-two point zero three for the population mean. Over many repeated samples, this method would capture the true mean about ninety-five percent of the time.",
      "watchCueId": "watch-07"
    }
  ],
