  "catalogueTitle": "Confidence intervals: z and t",
  "playerHeading": "Confidence intervals: z and t",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "confidence-intervals/index.html"
