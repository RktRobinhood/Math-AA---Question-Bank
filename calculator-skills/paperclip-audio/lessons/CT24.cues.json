  "script": "lessons/CT24.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "A locker is either ready (A) or in use (B). Columns of T are the current states; rows are the next states. Store T as t.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Type T, then Control and Template for the assignment symbol. On a Calculator page open Menu, then seven for Matrix and Vector, one for Create, and one for Matrix.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter zero point eight, zero point three then zero point two, zero point seven. The second column says a locker currently in use moves to Ready with probability zero point three.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Store s using the same menu, with two rows and one column. The locker starts Ready, so enter one above zero.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter t times s. The state column belongs on the right. The upper result, zero point eight, is the probability of Ready after one transition.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Enter T to the fourth power. Press Right to leave the exponent, then times S and Enter. Read zero point six two five after four transitions. Do not take the fourth power of each entry.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Repeat with exponent twenty-four. It is very close to zero point six for Ready. For these positive transitions the model tends to a unique steady state.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "At equilibrium, flow from Ready to In Use equals flow back. Zero point two times p equals zero point three times the quantity one minus p. So p is three fifths. That is exact; a finite power is only an approximation.",
      "watchCueId": "watch-08"
    }
  ],
