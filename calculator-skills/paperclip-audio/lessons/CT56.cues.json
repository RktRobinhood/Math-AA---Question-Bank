{
  "schemaVersion": 1,
  "id": "CT56",
  "route": "trapezoidal/index.html",
  "catalogueTitle": "Trapezoidal rule and approximation",
  "playerHeading": "Trapezoidal approximation",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "trapezoidal/index.html"
  },
  "script": "lessons/CT56.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Store the curve on a Calculator page so you can reuse its heights.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu, then one for Actions, then one for Define. Type f of x equals x squared, then press Enter.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Done means the function is stored. Now f of one, for example, means the height at x equals one.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Four equal strips have width one. Count their edges: there are five ordinates.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The first and last heights belong to one strip each. The interior heights belong to two.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Type half the width, times the bracket. Enter each end height once.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Group the interior heights so the factor of two applies to all three.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Enter returns twenty-two. Each ordinate is a function value; only the sum estimates the integral.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "Double the number of strips. The width halves, but there are now nine ordinates.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Keep both endpoints; double the seven interior heights. Multiply by zero point two five.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "Use the half-step x-values (zero point five, one point five, two point five and three point five) as well as the original x-values.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "Enter returns twenty-one point five. On this convex curve, the tops of the strips lie above the curve.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "The exact integral is sixty-four thirds, about twenty-one point three three three. Eight strips are closer here; that is not a guarantee for every function.",
      "watchCueId": "watch-13"
    }
  ],
