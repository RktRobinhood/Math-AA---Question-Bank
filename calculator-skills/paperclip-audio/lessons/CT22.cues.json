  "script": "lessons/CT22.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Rotate point P, at four, negative one, ninety degrees anticlockwise about the origin. On a Calculator page, type T, then Control and Template for the assignment symbol.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Choose Menu then seven: Matrix and Vector then one: Create then one: Matrix. Set two rows and two columns.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter the first row, zero and negative one. Enter the second row, one and zero. Tab between cells; Enter stores T.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Name P with the assignment symbol and use the same menu. Choose two rows and one column, not one row and two columns.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter x equals four above y equals minus one. Press Enter to store p.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Type t times p, in that order, then Enter. The inner dimensions two and two match.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The upper entry is x prime; the lower is y prime. Write the image of P as one, four. This rotation sends a point at x, y to negative y, x.",
      "watchCueId": "watch-07"
    }
  ],
