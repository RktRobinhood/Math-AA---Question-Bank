  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Find row A, column D: the shortest distance from A to D, not a full tour.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "There is no direct road from A to D. Compare both two-road routes and both routes that use the road between B and C.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "First add the two lengths on the route A to B to D. The first road is short, but the last one is not.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Next add the distances from A to C to D. Keep the total for comparison.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "A to B to C to D is also possible. Add all three road lengths, in order.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The reverse middle leg gives a different route. Add A to C to B to D as well.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Compare eleven, seven, eight and eighteen. Enter seven in row A, column D.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Two-way roads give the same distance in reverse. Tied routes share one table value.",
      "watchCueId": "watch-08"
    }
  ],
