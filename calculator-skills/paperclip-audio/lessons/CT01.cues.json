    {
      "id": "watch-01",
      "text": "Open a Calculator page."
    },
    {
      "id": "watch-02",
      "text": "Group the numerator and denominator before entering a fraction."
    },
    {
      "id": "watch-03",
      "text": "Use the scientific notation key for powers of 10."
    },
    {
      "id": "watch-04",
      "text": "Keep the negative sign inside the exponent."
    },
    {
      "id": "watch-05",
      "text": "Read the unrounded value first."
    },
    {
      "id": "watch-06",
      "text": "Scientific notation on the screen may use the letter E."
    },
    {
      "id": "watch-07",
      "text": "Show the requested precision in your written answer."
    },
    {
      "id": "watch-08",
      "text": "6.00 has three significant figures."
    }
  ],
