{
  "schemaVersion": 1,
  "id": "CT25",
  "route": "eigenvalues/index.html",
  "catalogueTitle": "Eigenvalues and long-run behaviour",
  "playerHeading": "Eigenvalues and long-run behaviour",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "eigenvalues/index.html"
  },
  "script": "lessons/CT25.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start from a two-by-two matrix. We will use its characteristic equation, not an eigenvalue menu.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Add the main diagonal entries for the trace.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "For the determinant, subtract the product off the diagonal from the product on it.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The characteristic equation is lambda squared minus seven lambda plus ten. Find its discriminant.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "For the square root, press Control and the x squared key. Enter nine, then press Right to leave the slot.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The discriminant is nine. Take its square root, three, and subtract it from the trace before dividing by two.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Use plus three instead. The matching upper root is five.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "For lambda equals five, the first row of the eigenvector equation gives y equals x. Set x equal to one; use the vector with entries one, one.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "The second entry is also five, so A times the vector gives five, five, or five times the whole vector. Any nonzero multiple of the eigenvector works.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "For lambda equals two, the first row gives y equals negative two x. For the vector with entries one, negative two, the product gives two, negative four.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "Five has the larger magnitude. Its direction dominates only if the starting vector has a component there.",
      "watchCueId": "watch-11"
    }
  ],
