{
  "schemaVersion": 1,
  "id": "CT15",
  "route": "piecewise/index.html",
  "catalogueTitle": "Piecewise, restricted and transformed graphs",
  "playerHeading": "Restricted and piecewise graphs",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "piecewise/index.html"
  },
  "script": "lessons/CT15.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "In Graphs, press the template key. Select the n-piece function template.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Set the number of pieces to two and press Enter.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Type the first expression. Move right to its condition. Control plus the equals key opens the inequality symbols.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Less than or equal to includes an endpoint. Strictly less than leaves it out. The first rule does not include x equals one.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Move down to the second row. Enter its expression, then move right to its condition.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Include x equals one in the second condition, so only one rule owns the join.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Press Enter to graph. The graph only exists where the conditions allow it.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "At the join, read the inequality before using the expression.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "Both outer endpoints are included. Outside the restricted domain the function is undefined.",
      "watchCueId": "watch-09"
    }
  ],
