  "spokenCues": [
    {
      "id": "watch-01",
      "text": "On a Calculator page, open Menu then three: Algebra then two: Solve System of Linear Equations.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Use two equations and keep the variables in x, y order. Confirm to insert the template.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter the first equation, including its equals sign. Then press Tab for the second line.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Enter the second equation. It can be in a different linear form. Press Enter to solve.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The order, x then y, tells you what each list entry means.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Substitute the pair into both equations to check.",
      "watchCueId": "watch-06"
    }
  ],
