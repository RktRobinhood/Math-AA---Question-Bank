  "route": "area-between/index.html",
  "catalogueTitle": "Area between two curves",
  "playerHeading": "Area between two curves",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "area-between/index.html"
  },
  "script": "lessons/CT55.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "In Graphs, enter f one of x equals x plus one and press Enter.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Press Tab. Enter f two of x equals three and press Enter.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "From x equals zero to x equals five, the curves cross at x equals two. The upper curve changes there.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Open Menu and choose Analyze Graph, then Bounded Area.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "With exactly two eligible curves, the tool selects them automatically.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "For the left region, type zero and press Enter.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Type two and press Enter. That stops the region at the crossing.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The left region has area two. Here the horizontal line is on top.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "Run Bounded Area again for the right region.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Type two and press Enter. Then type five and press Enter.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "The right region has area four point five. Now the sloping line is on top.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "Add the positive areas: two plus four point five equals six point five square units.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "When the upper curve changes, split there before calculating the area.",
      "watchCueId": "watch-13"
    }
  ],
