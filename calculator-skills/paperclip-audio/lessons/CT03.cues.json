  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start on a Calculator page. The same five badges can be lined up or chosen for a display.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "For a line-up of all five, type the number first. Choose Factorial to put the exclamation mark after it.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "The factorial counts complete line-ups. Change the order and you have a different line-up.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "This time choose two badges for a display with no roles. Swapping them does not make a new group.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter the total first, then a comma and the number chosen. Close the parenthesis and press Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read the exact number of groups. It is not a probability or a count of ordered choices.",
      "watchCueId": "watch-06"
    }
  ],
