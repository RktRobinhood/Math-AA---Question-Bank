  "script": "lessons/CT12.txt",
  "spokenCues": [
    {
      "id": "12.01",
      "text": "On a Graphs page, enter the function you want to investigate and press Enter."
    },
    {
      "id": "12.02",
      "text": "Open Menu, choose Analyze Graph, and select Minimum."
    },
    {
      "id": "12.03",
      "text": "We're looking for the lowest point in the interval you choose."
    },
    {
      "id": "12.04",
      "text": "To set the lower bound, move the cursor to the left of the minimum, then press Enter."
    },
    {
      "id": "12.05",
      "text": "For the upper bound, move to the right of the minimum and press Enter again."
    },
    {
      "id": "12.06",
      "text": "Bracket just one turning point."
    },
    {
      "id": "12.07",
      "text": "The calculator marks the minimum and shows its coordinates."
    },
    {
      "id": "12.08",
      "text": "The x-coordinate tells you where it occurs."
    },
    {
      "id": "12.09",
      "text": "The y-coordinate is the minimum value."
    }
  ],
