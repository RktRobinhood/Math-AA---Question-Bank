  "script": "lessons/CT52.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "On a Graphs page, enter f one of x and press Enter.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Press Control and G for f two. Shift and subtraction opens the first derivative template.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter x in the denominator box and f one of x in the expression box. Press Enter to graph f two.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Choose Menu then six: Analyze Graph then one: Zero. Select f two, the derivative, not f one.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Bracket one crossing of f two with bounds on either side. The zero gives an x-coordinate.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Substitute that x into f one. The derivative changes from positive to negative.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Repeat Zero on f two with a separate bracket around the second crossing.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Evaluate the original function again. This time the derivative changes from negative to positive.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "A derivative can touch zero without changing sign. A crossing search may miss it; verify a candidate separately.",
      "watchCueId": "watch-09"
    }
  ],
