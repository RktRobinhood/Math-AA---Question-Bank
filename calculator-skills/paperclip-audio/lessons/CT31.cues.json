  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start with two named lists. Values on the same row belong to the same observation.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "In Lists and Spreadsheet, open Statistics, then Stat Calculations. Choose the m x plus b form.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use the right arrow to choose the list named x val for X, then Tab. Choose the list named y val for Y.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Use each pair once. Keep the fitted equation in f one and the results starting in C.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Read m and b. The slope is the change in predicted y per extra unit of x.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read the two rows separately. r is positive here and gives the upward direction.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "A falling pattern can have the same r squared. Use the unsquared r to tell which way the pattern goes.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "For a prediction, substitute x into the fitted line. Do not use r or r squared as the slope.",
      "watchCueId": "watch-08"
    }
  ],
