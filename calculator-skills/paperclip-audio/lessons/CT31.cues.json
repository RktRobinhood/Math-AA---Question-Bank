  "catalogueTitle": "Pearson correlation and linear regression",
  "playerHeading": "Linear regression and Pearson r",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "linear-regression/index.html"
  },
