{
  "schemaVersion": 1,
  "id": "CT23",
  "route": "matrix-systems/index.html",
  "catalogueTitle": "Solve linear systems using matrices",
  "playerHeading": "Simultaneous equations with matrices",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "matrix-systems/index.html"
  },
  "script": "lessons/CT23.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Solve two x plus y equals seven, and x minus y equals two. Use x, y in that order. Store the coefficients as A using Control and Template for the assignment symbol.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On a Calculator page choose Menu then seven: Matrix and Vector then one: Create then one: Matrix. Use two rows and two columns.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter two, one in the first row and one, minus one in the second. Tab moves to the next cell. Press Enter to store a.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Store b the same way, but use two rows and one column. Enter seven above two to match the original equation order.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Type A, then the power key, the negative key and one. Press Right to leave the exponent, then the times key, B, and Enter. The inverse of A multiplies B on the left.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read x equals three above y equals one. In the original equations, twice three plus one is seven, and three minus one is two.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "For x plus two y equals four, and two x plus four y equals nine, enter a two by three matrix, M. Keep x, y first; put the constants in the final column.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Open Menu, then seven for Matrix and Vector, then five for Reduced Row-Echelon Form. Enter M as the argument and press Enter.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "The last row means zero times x plus zero times y equals one, so there is no solution. A zero row instead leaves one variable free here. For these cases, the inverse method does not apply.",
      "watchCueId": "watch-09"
    }
  ],
  "watch": {
    "timingBasis": "Runtime Watch seek-port scan at 75 ms with transitions refined to 1 ms; this is editorial/display clock, never measured speech. Very brief lights can be missed; authoredTape, where supplied, is authoritative.",
    "sliderEndAtExtractionMs": 69000,
    "captionCues": [
      {
        "id": "watch-01",
        "startMs": 0,
        "text": "Solve 2x + y = 7 and x − y = 2. Use x, y in that order. Store the coefficients as a with Ctrl + template (:=).",
        "endMs": 4000
      },
      {
        "id": "watch-02",
        "startMs": 4000,
        "text": "On a Calculator page choose Menu → 7: Matrix & Vector → 1: Create → 1: Matrix. Use 2 rows and 2 columns.",
        "endMs": 9000
      },
      {
        "id": "watch-03",
        "startMs": 9000,
        "text": "Enter 2, 1 in the first row and 1, −1 in the second. Tab moves to the next cell. Press Enter to store a.",
        "endMs": 15000
      },
      {
        "id": "watch-04",
        "startMs": 15000,
        "text": "Store b the same way, but use 2 rows and 1 column. Enter 7 above 2 to match the original equation order.",
        "endMs": 27000
      },
      {
        "id": "watch-05",
        "startMs": 27000,
        "text": "Type a, then ^, the negative key and 1. Press → to leave the exponent, then ×, b, Enter. A⁻¹ multiplies b on the left.",
        "endMs": 34000
      },
      {
        "id": "watch-06",
        "startMs": 34000,
        "text": "Read x = 3 above y = 1. In the original equations, 2(3) + 1 = 7 and 3 − 1 = 2.",
        "endMs": 39000
      },
      {
        "id": "watch-07",
        "startMs": 39000,
        "text": "For x + 2y = 4 and 2x + 4y = 9, enter a 2×3 matrix m. Keep x, y first; put the constants in the final column.",
        "endMs": 56000
      },
      {
        "id": "watch-08",
        "startMs": 56000,
        "text": "Select Menu → 7: Matrix & Vector → 5: Reduced Row-Echelon Form. Enter m inside rref( and press Enter.",
        "endMs": 62000
      },
      {
        "id": "watch-09",
        "startMs": 62000,
        "text": "The last row represents 0x + 0y = 1, so there is no solution. A zero row instead leaves one variable free here. This is a diagnostic, not the invertible exam case.",
        "endMs": 69000
      }
    ],
