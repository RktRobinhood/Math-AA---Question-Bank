  "catalogueTitle": "All trigonometric solutions in an interval",
  "playerHeading": "Find all trig solutions",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "trig-interval/index.html"
  },
  "script": "lessons/CT14.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "The equation is in degrees. Check Graphing Angle in the Graphs settings.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "The blue graph is the sine of x; the red line is zero point five. The window already covers the whole interval.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use Intersection. Put a lower and an upper bound around the crossing near one hundred and fifty degrees.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "thirty degrees counts. three hundred and ninety degrees also makes the equation true, but the interval excludes it.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Now the target is one, with x strictly between zero and one hundred and eighty degrees. The curves touch; there is no sign change.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Enter the upper bound, then compare the maximum height with the target.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The maximum is at ninety degrees, with a height of one. It touches the target, so count ninety degrees once.",
      "watchCueId": "watch-07"
    }
  ],
