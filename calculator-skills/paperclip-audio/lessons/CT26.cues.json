  "script": "lessons/CT26.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Enter the directed arrow counts. Rows are where a walk starts; columns are where it goes.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Two arrows go from A to B, so the entry in row A, column B is two. An absent arrow gives zero.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Open Matrix and Vector, then Create, then Matrix.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Set three rows and three columns. Fill each count, then press Tab.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "From after the last cell, press Control and Var to insert the store arrow, type A, then Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Type a raised to power two, then Enter. This uses matrix multiplication.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "From A to C, read row A, column C: two. The two parallel arrows from A to B each allow a walk through B. Read the reverse entry: zero.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "For exactly three edges, use a cubed instead. Do not add shorter lengths to it.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "There is one three-edge walk: A to C, back to A, then to C. Repeated vertices are allowed in a walk.",
      "watchCueId": "watch-09"
    }
  ],
