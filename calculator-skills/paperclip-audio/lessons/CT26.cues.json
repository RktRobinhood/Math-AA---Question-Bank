  "catalogueTitle": "Adjacency matrices and walks",
  "playerHeading": "Adjacency matrices and walks",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "adjacency-walks/index.html"
