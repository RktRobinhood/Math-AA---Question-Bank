  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start with two named columns. Each row is one paired observation.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "In Lists and Spreadsheet, choose Statistics, Stat Calculations, then Quadratic Regression.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use the right arrow and Tab to choose the lists x val for X and y val for Y.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Store the fit to f one. Keep each pair once and the results in C. Press Enter.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Read a, b and c in order. R squared summarises this fit; it is not another coefficient in the equation.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Predict at x equals one point five by substituting it into the fitted equation, not reading a nearby data row.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The curve bends down. Its vertex lies inside the observed interval and is higher than both endpoints.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "At x equals two the recorded value was nineteen point five. The fitted curve predicts eighteen there. The model need not pass through any observation.",
      "watchCueId": "watch-08"
    }
  ],
