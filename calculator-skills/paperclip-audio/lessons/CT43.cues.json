  "catalogueTitle": "Sampling means and the central limit theorem",
  "playerHeading": "Sampling means and the CLT",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "sampling-means/index.html"
