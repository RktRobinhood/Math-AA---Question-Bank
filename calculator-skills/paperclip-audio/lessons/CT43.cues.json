  "script": "lessons/CT43.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "We want an average, not one observation. Independent population readings have mean eighty and standard deviation twelve.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "The sample mean keeps the same centre. Its spread is the standard error: twelve divided by the square root of thirty-six.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "For this large sample, the CLT gives an approximately normal mean. A normal population would give an exact normal mean.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "On a Calculator page, open Probability, Distributions, then Normal Cdf.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter the lower and upper bounds of the interval.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Keep the mean at eighty. Enter two as the standard deviation of the mean, not twelve and not the variance four.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Enter inserts the command, then Enter again evaluates it.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The chance is about zero point seven seven five under the normal approximation. Distinguish an exact normal model from an approximation.",
      "watchCueId": "watch-08"
    }
  ],
