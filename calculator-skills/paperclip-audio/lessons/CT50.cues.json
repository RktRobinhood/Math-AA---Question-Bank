  "script": "lessons/CT50.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Eight of sixteen independent checks pass. Does the pass rate exceed the usual twenty-five percent?",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Higher is the alternative, so look at eight or more. Include the observed eight.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "On a Calculator page choose Probability, Distributions, then Binomial C D F.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Enter sixteen trials and the null probability, zero point two five, not the sample proportion of eight out of sixteen.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Set the lower bound to eight and the upper bound to sixteen. Both are included.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Enter inserts the command. Enter again finds the whole upper tail.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The tail probability is about zero point zero two seven one. It is below zero point zero five: reject the null hypothesis.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "For a lower alternative, count from zero through the observation. The LCD still shows the upper-tail example.",
      "watchCueId": "watch-08"
    }
  ],
