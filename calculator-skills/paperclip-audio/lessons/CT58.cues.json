  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Estimate y at x equals one in two steps. Start at the known point zero, two.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Use the starting pair for the slope: zero minus two equals minus two. Multiply the slope by the step size.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "On a Calculator page, type two, plus zero point five times the quantity zero minus two, then press Enter.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The new y is one, and the new x is zero point five. Keep that pair together.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Now find the slope from the new pair: zero point five minus one equals minus zero point five. The previous slope is no longer used.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Type one, plus zero point five times the quantity zero point five minus one. Then press Enter. This is the second update.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "At x equals one the Euler estimate is zero point seven five. Two tangent steps give an approximation, not an exact solution.",
      "watchCueId": "watch-07"
    }
  ],
