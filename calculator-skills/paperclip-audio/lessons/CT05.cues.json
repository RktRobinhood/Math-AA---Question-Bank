  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Deposit one thousand for two years at six percent nominal interest, compounded monthly. There are no later payments.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On a Calculator page, press Menu then eight: Finance then one: Finance Solver.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Two years times twelve months gives twenty-four payment periods. Enter six for the annual percentage rate.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Present value is negative one thousand: the deposit leaves you now. Payment is zero because there are no recurring payments.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Skip future value. To count periods in months, set payments per year and compounding periods per year to twelve. Leave payment timing at End; it has no effect without recurring payments.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Move back to FV, then press Enter to solve for the highlighted field.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "A positive future value is money you receive at the end. Rounded to two decimal places, the balance is one thousand, one hundred and twenty-seven point one six.",
      "watchCueId": "watch-07"
    }
  ],
