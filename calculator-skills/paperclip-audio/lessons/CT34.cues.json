  "catalogueTitle": "Linearizing data with logarithms",
  "playerHeading": "Linearizing with logarithms",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "log-linearization/index.html"
