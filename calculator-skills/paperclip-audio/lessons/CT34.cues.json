  "script": "lessons/CT34.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Each response is positive, so we can take its natural logarithm.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Move to column C's name cell. Call the new list L N Y.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "In the formula cell, press Control and the e to the x key for natural log. Enter the list named y val and close the bracket.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Enter calculates every log in the new column. Keep the same pairing by row.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "On Lists and Spreadsheet, choose Menu, Statistics, Stat Calculations, then Linear Regression in the m x plus b form.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Keep x val as the X list. In the Y menu choose L N Y. Press Enter to fit the transformed response.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The slope is the natural log of two and the intercept is the natural log of three. The saved line predicts the natural log of y.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Exponentiate the slope and intercept to get the multiplier and initial value. Use the original y-scale for predictions.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "A log-log power fit would transform x too. Do not use that workflow for this exponential example.",
      "watchCueId": "watch-09"
    }
  ],
