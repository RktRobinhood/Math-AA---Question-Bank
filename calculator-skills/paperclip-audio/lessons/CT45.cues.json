  "script": "lessons/CT45.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "A normal population has known standard deviation four. Test whether its mean is below fifty using an independent sample.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Use a z test because the population standard deviation is known. Choose the less-than alternative before seeing the test result.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "The independent observations are already in column A. Open the one-sample z Test.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Choose Data because the individual readings are already in a named list.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter the null mean fifty and the known population standard deviation four. Then choose readings for List.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Keep frequency at one. Change the alternative to less than. Leave the optional graph unchecked.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Under the null hypothesis, the chance of a z score of negative three or lower is about zero point zero zero one three five. The test counted nine observations from the list.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "There is evidence that the mean is below fifty. A two-sided alternative would use both tails.",
      "watchCueId": "watch-08"
    }
  ],
