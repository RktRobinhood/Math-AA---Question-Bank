    {
      "id": "watch-01",
      "text": "Enter the function in the Graphs application and press Enter."
    },
    {
      "id": "watch-02",
      "text": "The default window may hide the interesting feature."
    },
    {
      "id": "watch-03",
      "text": "Here the vertex lies beyond the usual central view."
    },
    {
      "id": "watch-04",
      "text": "Set the horizontal and vertical limits independently."
    },
    {
      "id": "watch-05",
      "text": "A viewing window does not change the domain."
    },
    {
      "id": "watch-06",
      "text": "This window contains the vertex with space on both sides."
    },
    {
      "id": "watch-07",
      "text": "Use your context to choose sensible bounds."
    }
  ],
