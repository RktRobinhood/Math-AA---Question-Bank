  "script": "lessons/CT47.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "A random sample records each student once: how they commute and whether they arrive on time. Test for association.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "The null hypothesis says commute mode and arrival status are independent. The alternative is that they are associated. Choose a five percent significance level before testing.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Type A, then Control and Template for the assignment symbol. Use Menu, Matrix and Vector, Create, Matrix. Choose three rows and two columns.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Enter the Walk, Cycle and Bus counts, row by row. Use Tab between cells and Enter to store a. Leave out totals and percentages.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Open Menu, Statistics, Stat Tests, then the chi squared two-way test. Enter A as the observed matrix and confirm.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read chi squared, the p value and the degrees of freedom. The p value is an upper-tail probability under the null hypothesis, not the probability that the null hypothesis is true.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "On the next input line, enter stat dot exp mat. Expected counts are the counts predicted under independence. Here all are greater than five.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The p value is about zero point zero zero one five eight, below zero point zero five. Reject the null hypothesis. The sample gives evidence of association between commute mode and arrival status, not causation.",
      "watchCueId": "watch-08"
    }
  ],
