{
  "schemaVersion": 1,
  "id": "CT42",
  "route": "poisson/index.html",
  "catalogueTitle": "Poisson: exact and cumulative probabilities",
  "playerHeading": "Poisson probabilities",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "poisson/index.html"
  },
  "script": "lessons/CT42.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "The Poisson model averages three events per ten minutes. We are counting in twenty minutes.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Double the mean. Use lambda equals six for this interval.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "For exactly six events, type the Poisson P D F command on a Calculator page. Enter six for the mean and six for the count.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Press Enter once to evaluate a typed command.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Exactly six has probability about zero point one six one.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "For three to six events inclusive, use the Poisson C D F command with mean six, lower bound three, and upper bound six.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "PDF takes one count. CDF adds every count between its two bounds.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Counts three, four, five and six together have probability about zero point five four four.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "More than six excludes six. Its complement includes every count from zero through six.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Type one minus Poisson C D F, with mean six, lower bound zero and upper bound six. Press Enter.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "More than six has probability about zero point three nine four.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "At least six includes six. Its complement now stops at five.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "Type one minus Poisson C D F, with mean six, lower bound zero and upper bound five. Press Enter.",
      "watchCueId": "watch-13"
    },
    {
      "id": "watch-14",
      "text": "At least six has probability about zero point five five four. The two answers differ by the probability of exactly six.",
      "watchCueId": "watch-14"
    }
  ],
