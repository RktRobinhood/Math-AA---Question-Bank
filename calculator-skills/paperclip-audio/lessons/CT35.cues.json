  "spokenCues": [
    {
      "id": "watch-01",
      "text": "The paired rows are x: twenty-one, seven, fifteen, eleven and y: seven, twelve, five, seven.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "The x ranks in the original row order are four, one, three, two. Enter these in the list named r x.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "The two sevens would occupy ranks two and three. Give each two point five.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Enter the y-ranks in the original row order: two point five, four, one, two point five.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Open Menu, then four for Statistics, one for Stat Calculations, and four for Linear Regression in the a plus b x form.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Use the rank lists rx and ry. Run the calculation, then look for r.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Pearson r on the paired ranks equals Spearman's rank correlation. Here it is about negative zero point six three two.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The number describes monotonic association, not proof that a change in one variable causes the other.",
      "watchCueId": "watch-08"
    }
  ],
