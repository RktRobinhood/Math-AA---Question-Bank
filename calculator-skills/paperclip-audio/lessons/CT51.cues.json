    {
      "id": "watch-01",
      "text": "On a Graphs page, plot f of x equals x cubed plus x.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu, six for Analyze Graph, then five for d y by d x.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Move to the point on the curve at x equals two, then click. You select one point, not two bounds.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The graph reports the slope. Evaluate f of two separately to find the point on the curve.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Put the slope and the point into point-slope form.",
      "watchCueId": "watch-05"
    }
  ],
