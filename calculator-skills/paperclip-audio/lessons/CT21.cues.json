  "catalogueTitle": "Matrices: entry, determinant and inverse",
  "playerHeading": "Determinant & inverse",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "matrices/index.html"
