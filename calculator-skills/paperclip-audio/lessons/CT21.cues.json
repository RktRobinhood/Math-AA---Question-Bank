  "script": "lessons/CT21.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start on a Calculator page. Type A, then Control and Template, to name the matrix with the assignment symbol.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu then seven: Matrix and Vector then one: Create then one: Matrix. Set the number of rows and columns.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Fill the matrix from left to right, row by row. Use Tab to move between cells. Press Enter to store it.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Type the determinant command with A in brackets, then press Enter. The determinant is a single number.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "For a square matrix with nonzero determinant, type A, press the power key, then the negative key and one. Press Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The inverse is another matrix. If the determinant is zero, the matrix is singular and has no inverse.",
      "watchCueId": "watch-06"
    }
  ],
