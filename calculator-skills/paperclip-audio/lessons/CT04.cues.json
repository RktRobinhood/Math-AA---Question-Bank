  "id": "CT04",
  "route": "sequences/index.html",
  "catalogueTitle": "Sequences, sigma and first threshold",
  "playerHeading": "Sequences and finite sums",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "sequences/index.html"
  },
  "script": "lessons/CT04.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Find one term first: substitute n equals five into the rule.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "For the fifth term, replace n with five. Keep the exponent in brackets.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "The fifth term is forty-eight. That is not the total of the first five terms.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "For a total of consecutive terms, open Menu then four: Calculus then three: Sum.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Type n, then Tab to the lower index, upper index and rule.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Enter the original rule in n. The template automatically steps by one.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Enter gives ninety-three: the total of all five terms, including both endpoints.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Need every second index? Open Statistics, List Operations, then Sequence to insert the sequence command.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "Type the rule, then press Right to leave the exponent before typing the comma.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "Enter n, the lower and upper indices, then the step. That last two is not the number of terms.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "This produces a list of four terms, not their sum.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "For the total, first open Statistics, List Math, then Sum of Elements to insert the sum command.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "Inside the sum command, insert the sequence command again. Keep the last argument, a step of two.",
      "watchCueId": "watch-13"
    },
    {
      "id": "watch-14",
      "text": "Enter gives five hundred and ten. The outer sum adds only the terms created by the sequence command.",
      "watchCueId": "watch-14"
    },
    {
      "id": "watch-15",
      "text": "For a first threshold, find the first integer index whose term passes the target, not the first total that does.",
      "watchCueId": "watch-15"
    }
  ],
