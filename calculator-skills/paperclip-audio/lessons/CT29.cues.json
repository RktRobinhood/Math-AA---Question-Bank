  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Column A is named values. For the first run, use each row once.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Menu then four: Statistics then one: Stat Calculations then one: One-Variable Statistics. Confirm one list.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Choose the list named values for the first X list. Leave Frequency List at one. Send the results to column C.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Read the result names in C and values in D. Use sigma x for the whole collection, or s sub x for sample standard deviation.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Run the same menu. Keep the list named values for the first X list. Instead of one, choose the list named freq for Frequency List.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Confirm and read the new mean and sigma x. Now n is the sum of the frequencies, not the number of rows.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Check that n counts observations, not rows. Open Try for a different collection.",
      "watchCueId": "watch-07"
    }
  ],
