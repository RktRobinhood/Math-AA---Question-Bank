  "spokenCues": [
    {
      "id": "watch-01",
      "text": "On Data and Statistics, press Tab. Select the prepared list reading on the horizontal axis.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Menu, Plot Type, Histogram. The vertical scale counts observations.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Open Plot Properties, Histogram Properties, Bin Settings, Equal Bin Width. Width is the interval size; alignment sets a boundary.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Type ten for width. Tab to Alignment and type ten again. Confirm the settings.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Use Analyze, Graph Trace. Press Right until you reach the class from twenty up to, but not including, thirty.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Five observations fall here. Twenty belongs here; thirty starts the next bin.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Add the bins that end at or below forty. The reading at forty is not included.",
      "watchCueId": "watch-07"
    }
  ],
