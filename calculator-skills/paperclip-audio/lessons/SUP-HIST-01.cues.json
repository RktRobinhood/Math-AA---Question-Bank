    "anchors": [
      {
        "id": "watch-01",
        "editorial": "Show only the prepared reading list. TAB activates the horizontal add-variable strip; Select closes the list pick."
      },
      {
        "id": "watch-02",
        "editorial": "Menu, then 1 then 3; plot switches from dot to Frequency histogram. Do not show a solved requested count."
      },
      {
        "id": "watch-03",
        "editorial": "Menu, 2, 2, 2, 1; last key opens Equal Bin Width Settings with Width selected."
      },
      {
        "id": "watch-04",
        "editorial": "Use 1, 0, Tab, 1, 0, Enter. Confirm the same value for width and alignment; rebin only on Enter."
      },
      {
        "id": "watch-05",
        "editorial": "Menu, 4, A, Right; LCD shows [20, 30), 5 points when the required bin is selected."
      },
      {
        "id": "watch-06",
        "editorial": "Hold the selected trace, then show the half-open edge marker. No new keys."
      },
      {
        "id": "watch-07",
        "editorial": "Hold the histogram. Show a separate lesson overlay for 4 + 5 + 3 = 12. No cumulative-plot command or Try values."
      }
    ]
