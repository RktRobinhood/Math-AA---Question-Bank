  "script": "lessons/CT06.txt",
  "spokenCues": [
    {
      "id": "solve-1",
      "text": "On a Calculator page, open Menu, choose Algebra, then Numerical Solve."
    },
    {
      "id": "solve-2",
      "text": "Enter the equation, then a comma and the variable you’re solving for."
    },
    {
      "id": "solve-3",
      "text": "To limit the search to an interval, add a comma, then enter the lower and upper bounds separated by another comma."
    },
    {
      "id": "solve-4",
      "text": "Close the bracket and press Enter. The calculator gives one numerical solution."
    },
    {
      "id": "solve-5",
      "text": "If the equation may have more than one solution, use separate intervals and check each result."
    },
    {
      "id": "solve-6",
      "text": "Keep the calculator’s full precision while you work, then round the final answer as the question asks."
    }
  ],
