  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Plot f of x equals x minus three on a Graphs page.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu then six: Analyze Graph then six: Integral.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "This page contains one curve. If prompted on your handheld, select the curve first.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Type zero for the lower bound and press Enter.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Type four for the upper bound and press Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The integral is minus four. The contribution below the x-axis is negative.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "For geometric area, split where the graph crosses the axis, at x equals three.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "Add the magnitudes: four point five below and zero point five above. Total geometric area is five.",
      "watchCueId": "watch-08"
    }
  ],
