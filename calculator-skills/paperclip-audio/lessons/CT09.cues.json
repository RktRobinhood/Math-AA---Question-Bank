  "script": "lessons/CT09.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "On a Graphs page, plot f of x equals two x squared minus three.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Menu then five: Trace then one: Graph Trace. Step along the curve with the arrows.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "To jump to a given input, type its x-value and press Enter. Read the second coordinate.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Press Esc to leave Trace. Open a split-screen table with Control and T, or use Menu then seven then one.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Auto gives a regular list. Focus the table and use Menu then two: Table then five: Edit Table Settings. Change Independent to Ask.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Type the x values you want in the x column. Read each result from the same row in f one of x.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "Trace locates a point on the graph. A table keeps the results for multiple inputs together.",
      "watchCueId": "watch-07"
    }
  ],
