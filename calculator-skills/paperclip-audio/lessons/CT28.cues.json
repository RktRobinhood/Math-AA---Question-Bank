  "spokenCues": [
    {
      "id": "watch-01",
      "text": "To record laps for a group, start a new Lists and Spreadsheet page.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Name column A in its top name cell. Leave the formula row blank and go to numbered row one.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter the measured values down column A. Enter stores each value and moves down.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Name column B separately. Enter the counts on the same numbered rows as the values.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "A count of zero is data. Do not leave that cell blank.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read across a row: the measured value seven occurred twice. Read down the counts for the total.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "If you start from raw readings instead, give the list one name and enter every observation, including repeats.",
      "watchCueId": "watch-07"
    }
  ],
