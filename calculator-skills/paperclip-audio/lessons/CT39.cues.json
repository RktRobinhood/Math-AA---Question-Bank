  "spokenCues": [
    {
      "id": "39.01",
      "text": "Shade the area you want. Here, it’s between eighteen and twenty-three."
    },
    {
      "id": "39.02",
      "text": "On a Calculator page, press Menu. Choose Probability, then Distributions, then Normal C D F."
    },
    {
      "id": "39.03",
      "text": "The lower bound is eighteen. The upper bound is twenty-three."
    },
    {
      "id": "39.04",
      "text": "Enter the mean, twenty. Then the standard deviation, two. Use two, not the variance of four."
    },
    {
      "id": "39.05",
      "text": "Confirm the dialog. Press Enter again to calculate. The probability is about zero point seven seven five."
    },
    {
      "id": "39.06",
      "text": "Now shade the upper tail, beyond twenty-two. Open Menu, then Probability, Distributions, and Normal C D F again."
    },
    {
      "id": "39.07",
      "text": "Enter twenty-two as the lower bound. Leave the upper bound at infinity. Keep the mean at twenty and the standard deviation at two."
    },
    {
      "id": "39.08",
      "text": "Confirm, then press Enter again. The upper-tail probability is about zero point one five nine."
    }
  ],
