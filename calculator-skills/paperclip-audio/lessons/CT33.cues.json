  "catalogueTitle": "Exponential regression and growth factors",
  "playerHeading": "Exponential regression",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "exponential-regression/index.html"
  },
  "script": "lessons/CT33.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Each row records dough volume at one hour. Every volume must be positive because exponential regression fits the natural log of y.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Open Statistics, then Stat Calculations. Press the letter A, even if the option is below the visible list.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use the right arrow and Tab. Set the list called x val as the X List and y val as the Y List.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Use each pair once. Save to f one and keep the results in C and D. Press Enter.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Read a and b. The value a is the estimate at x equals zero. It need not equal the measurement there.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "A one-unit rise in x multiplies the estimate by b. Here that is about a fifty point seven percent increase.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The r and r squared rows assess the line fitted to x and the natural log of y, not the raw readings.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "At x equals two point five the input is inside the observed span. Substituting gives an interpolation.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "At x equals six the input is outside the observed span. The model can predict, but the trend may not continue.",
      "watchCueId": "watch-09"
    }
  ],
