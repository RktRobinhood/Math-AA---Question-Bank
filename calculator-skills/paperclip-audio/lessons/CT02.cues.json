  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Find the principal angle for sine theta equals zero point six, in degrees. Check the top-right rad or deg label.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Use the touchpad to move the pointer to rad. Click the touchpad centre. Rad changes to deg.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Press trig. Move down to inverse sine and press Enter. The minus one means inverse, not reciprocal.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Type zero point six and press Enter. Inverse sine takes a ratio and gives an angle.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "About thirty-six point eight seven degrees. That is one principal angle. If asked for all solutions, check the whole interval.",
      "watchCueId": "watch-05"
    }
  ],
