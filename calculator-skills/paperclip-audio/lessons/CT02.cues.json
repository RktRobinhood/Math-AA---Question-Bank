  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Given that the sine of theta is zero point six, find the principal angle in degrees. Check the angle mode first.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Press Home, then five: Settings and two: Document Settings.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Tab to Angle, press Right, select Degree, then tab to OK and confirm.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Return to the current document. Press Trig and choose inverse sine, not sine.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Enter zero point six and press Enter. Inverse sine turns a ratio into an angle, not its reciprocal.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The display is in degrees. The calculator gives one principal angle; check the range for other solutions.",
      "watchCueId": "watch-06"
    }
  ],
