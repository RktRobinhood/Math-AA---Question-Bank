  "script": "lessons/CT17.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start at the base. The drone is six kilometres west, eight kilometres south, and five kilometres above it.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "From Calculator, press Home then five: Settings then two: Document Settings. Set Angle to Degree.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Press Control, then the x squared key, to insert a square root. Square the east and north distances and add them inside the root.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Measure clockwise from north. In the south-west, add the acute angle west of south to one hundred and eighty degrees.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Compare the rise with the horizontal distance, not the sloping line.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "For the straight-line distance, all three perpendicular displacements contribute.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The bearing is two hundred and seventeen degrees to the nearest degree. The sloping distance is eleven point two kilometres to three significant figures.",
      "watchCueId": "watch-07"
    }
  ],
