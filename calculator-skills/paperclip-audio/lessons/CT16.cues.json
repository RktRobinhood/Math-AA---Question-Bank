  "spokenCues": [
    {
      "id": "watch-01",
      "text": "A culture is ready at twelve units. How soon?",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Enter the growth model in f one.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "In f two, enter twelve for the horizontal target.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Press Menu, six: Analyze Graph, four: Intersection.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Put the lower bound at day two. Press Enter.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Put the upper bound at day three. Press Enter.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The x-coordinate is the continuous time: about two point one six days.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "If you can check only once per whole day, don't round to the nearest day.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "At day two, the model is only eleven point two five units.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "At day three, it is sixteen point eight seven five units. That meets the target.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "The model rises, so day three is the first eligible whole day.",
      "watchCueId": "watch-11"
    }
  ],
