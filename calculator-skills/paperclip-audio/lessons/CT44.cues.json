  "spokenCues": [
    {
      "id": "watch-01",
      "text": "A fair five-sector spinner has blue sectors one and two. Use one random integer from one to five for each spin.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On a Calculator page open Probability, Random, then Integer.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Enter the first label, last label, and number of spins. Both labels are included.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Count every blue result, including repeats. Here one or two appears five times in the twelve observed outcomes.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "Choose the same command with the same inputs. Press Enter again after entering those inputs; the new run uses fresh draws.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "The next list gives three blues in twelve spins. The estimates differ; the exact two divided by five stays the same.",
      "watchCueId": "watch-06"
    }
  ],
