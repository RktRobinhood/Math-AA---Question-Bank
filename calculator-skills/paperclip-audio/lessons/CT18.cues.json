  "route": "voronoi/index.html",
  "catalogueTitle": "Voronoi sites and nearest neighbours",
  "playerHeading": "Voronoi sites and nearest neighbours",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "voronoi/index.html"
  },
  "script": "lessons/CT18.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Point P is at three, two. Site A is at one, one; B is at seven, one; and C is at five, six. Their readings are fifteen, thirty-two and forty-eight. Which site's reading estimates P?",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On the Calculator page, enter the square of three minus one, plus the square of two minus one. Close each bracket and press the x squared key, then press Enter. No square root is needed.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use the same P, but subtract B's coordinates. Square three minus seven, then add the square of two minus one. A negative difference becomes positive when squared.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Now use C. Square three minus five, then add the square of two minus six. Compare all the results, not just A and B.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The squared distances are A: five, B: seventeen, C: twenty. Site A is nearest. The estimate at P is A's reading, fifteen, not an average.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Now move P to four, two. Its offsets from A are three and one; from B they are negative three and one. Enter three squared plus one squared to check both.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "For C, the offsets are negative one and negative four. Enter negative one squared plus negative four squared, using the negative key inside each pair of brackets.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "A and B tie at ten; C is farther at seventeen. This point lies on their cell boundary. With readings fifteen and thirty-two, no unique estimate exists unless a tie-break rule is given.",
      "watchCueId": "watch-08"
    }
  ],
  "watch": {
