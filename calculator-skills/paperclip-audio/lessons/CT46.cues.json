  "route": "t-tests/index.html",
  "catalogueTitle": "One-sample and two-sample t-tests",
  "playerHeading": "One- and two-sample t-tests",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "t-tests/index.html"
  },
  "script": "lessons/CT46.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "For the same items measured twice, first compute one difference per item. Here use the nine differences, not two independent lists.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Population standard deviation is unknown. On Calculator, choose Menu then six Statistics then seven Stat Tests then two t Test. Switch Data Input Method to Stats.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Use zero for the hypothesised mean, three for the sample mean, four for the sample standard deviation, and nine for the sample size. The claim is an increase. Choose mean greater than the hypothesised mean, and confirm.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "The t statistic is two point two five, with eight degrees of freedom. The one-sided p value is about zero point zero two seven two eight. At five percent, reject the null hypothesis. There is evidence the mean difference is positive.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "For independent normal groups with equal population variances, choose Stat Tests, then option four for the two-sample t test. Switch to Stats.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Group one: sample mean thirty-five, sample standard deviation four, sample size ten. Group two: sample mean thirty-one, sample standard deviation five, sample size twelve. Choose the not-equal alternative and set Pooled to Yes.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The two-sided p value is about zero point zero five four seven, above zero point zero five. Do not reject the null hypothesis. That is not evidence the two means are equal.",
      "watchCueId": "watch-07"
    }
  ],
  "watch": {
    "timingBasis": "Runtime Watch seek-port scan at 75 ms with transitions refined to 1 ms; this is editorial/display clock, never measured speech. Very brief lights can be missed; authoredTape, where supplied, is authoritative.",
    "sliderEndAtExtractionMs": 58000,
