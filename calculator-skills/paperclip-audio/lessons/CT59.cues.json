  "spokenCues": [
    {
      "id": "watch-01",
      "text": "Start with the point one, zero. In each step, find both slopes from the same old point.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "On the Calculator page, type one plus zero point two five times zero, then Enter. This gives the first new x value, which is one.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Still using the point one, zero, type zero plus zero point two five times the quantity negative two times one minus zero. Press Enter. The first new y value is negative zero point five.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Now use the first new pair. Type one plus zero point two five times negative zero point five for the second new x value.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "For the second new y value, keep using the pair one, negative zero point five. Enter negative zero point five, plus zero point two five times the quantity negative two times one plus zero point five.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Read the phase samples in arrow order. Neither axis is time. Exit Focus if needed to see the sketch below.",
      "watchCueId": "watch-06"
    }
  ],
  "watch": {
