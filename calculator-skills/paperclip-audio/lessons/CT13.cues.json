  "catalogueTitle": "Graphical inequalities and exclusions",
  "playerHeading": "Graphical inequalities",
  "status": "draft-from-original-watch",
  "scriptSource": {
    "type": "speech-copy-of-original-watch-captions",
    "file": "inequalities/index.html"
  },
  "script": "lessons/CT13.txt",
  "spokenCues": [
    {
      "id": "watch-01",
      "text": "In Graphs, plot f one of x equals x squared minus four, divided by x minus one. Put each expression in its own brackets.",
      "watchCueId": "watch-01"
    },
    {
      "id": "watch-02",
      "text": "Press Tab. Plot f two of x equals zero. We want f one of x to be less than or equal to f two of x, with x from negative four to four inclusive.",
      "watchCueId": "watch-02"
    },
    {
      "id": "watch-03",
      "text": "Open Menu then six: Analyze Graph then four: Intersection.",
      "watchCueId": "watch-03"
    },
    {
      "id": "watch-04",
      "text": "Bracket the first crossing from minus three to minus one. Confirm each bound.",
      "watchCueId": "watch-04"
    },
    {
      "id": "watch-05",
      "text": "The first crossing is x equals minus two. Record it.",
      "watchCueId": "watch-05"
    },
    {
      "id": "watch-06",
      "text": "Run Intersection again. Bracket the second crossing from one point five to three.",
      "watchCueId": "watch-06"
    },
    {
      "id": "watch-07",
      "text": "The second crossing is x equals two. Record it.",
      "watchCueId": "watch-07"
    },
    {
      "id": "watch-08",
      "text": "The denominator x minus one is zero at x equals one. That point is undefined, not an intersection.",
      "watchCueId": "watch-08"
    },
    {
      "id": "watch-09",
      "text": "Split the domain at minus two, one and two. Check one value in each interval.",
      "watchCueId": "watch-09"
    },
    {
      "id": "watch-10",
      "text": "At x equals minus three, f one is below f two. At x equals zero, it is above.",
      "watchCueId": "watch-10"
    },
    {
      "id": "watch-11",
      "text": "At x equals one point five, f one is below f two again. At x equals three, it is above.",
      "watchCueId": "watch-11"
    },
    {
      "id": "watch-12",
      "text": "Include the equal points at negative two and two because the inequality includes equality. Leave x equals one out.",
      "watchCueId": "watch-12"
    },
    {
      "id": "watch-13",
      "text": "At the domain edge x equals minus four, f one is below f two, so include minus four too.",
      "watchCueId": "watch-13"
    }
  ],
