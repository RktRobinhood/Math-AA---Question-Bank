{
  "schemaVersion": 1,
  "id": "CT41",
  "route": "normal-parameter/index.html",
  "catalogueTitle": "Solve an unknown normal parameter",
  "playerHeading": "Unknown normal parameter",
  "status": "recording-ready-native-contract",
  "scriptSource": {
    "type": "original-recording-cue-sheet",
    "file": "DISTRIBUTION-RECORDING-CUE-SHEET.md"
  },
  "script": "lessons/CT41.txt",
  "spokenCues": [
    {
      "id": "41.01",
      "text": "Ten percent is below twenty. The standard deviation is five. To find the mean, first match that percentile on the standard normal curve."
    },
    {
      "id": "41.02",
      "text": "On a Calculator page, press Menu. Choose Probability, then Distributions, then Inverse Normal."
    },
    {
      "id": "41.03",
      "text": "Enter zero point one for the left area, zero for the mean, and one for the standard deviation."
    },
    {
      "id": "41.04",
      "text": "Confirm, then press Enter again. The standard normal z-score is negative. Keep the calculator’s stored value."
    },
    {
      "id": "41.05",
      "text": "The mean is twenty minus five times that z-score. Type twenty minus five times. Press Control, then the negative key, to insert the previous answer. Press Enter. The mean is about twenty-six point four."
    },
    {
      "id": "41.06",
      "text": "Now ninety percent is below sixty-three, and the mean is fifty-two. We’re finding the standard deviation. Open Menu, Probability, Distributions, and Inverse Normal again."
    },
    {
      "id": "41.07",
      "text": "Use the left area, zero point nine. Again enter zero for the mean and one for the standard deviation. Confirm, then press Enter again. This z-score is positive."
    },
    {
      "id": "41.08",
      "text": "Open a bracket. Enter sixty-three minus fifty-two, then close the bracket. Divide by the previous answer: Control, then the negative key. Press Enter. The standard deviation is about eight point five eight. It’s positive, as a spread must be."
    },
    {
      "id": "41.09",
      "text": "If the question gives the right tail, subtract its probability from one before using Inverse Normal. The Area field takes the area to the left."
    }
  ],
  "watch": {
    "timingBasis": "Runtime Watch seek-port scan at 75 ms with transitions refined to 1 ms; this is editorial/display clock, never measured speech. Very brief lights can be missed; authoredTape, where supplied, is authoritative.",
    "sliderEndAtExtractionMs": 62000,
    "captionCues": [
      {
        "id": "watch-01",
        "startMs": 0,
        "text": "We know that ten percent is below twenty, and the standard deviation is five. We need the mean, not another cutoff.",
        "endMs": 5000
      },
      {
        "id": "watch-02",
        "startMs": 5000,
        "text": "On a Calculator page, open Inverse Normal. Enter zero point one for the area, zero for the mean and one for the standard deviation. This gives a z-score.",
        "endMs": 18000
      },
      {
        "id": "watch-03",
        "startMs": 18000,
        "text": "Rearrange: the mean is the cutoff minus five times z. Use Control then the negative key to insert the previous answer without rounding it.",
        "endMs": 28000
      },
      {
        "id": "watch-04",
        "startMs": 28000,
        "text": "This time, ninety percent is below sixty-three and the mean is fifty-two. Find the standard normal z-score for zero point nine.",
        "endMs": 43000
      },
      {
        "id": "watch-05",
        "startMs": 43000,
        "text": "The standard deviation is the cutoff minus the mean, all divided by z. Keep the brackets, reuse the previous answer, and check that the spread is positive.",
        "endMs": 52400
      },
      {
        "id": "watch-06",
        "startMs": 52400,
        "text": "For a right-tail question, subtract the stated probability from one first. The Inverse Normal Area field takes area to the left.",
        "endMs": 62000
      }
    ],
