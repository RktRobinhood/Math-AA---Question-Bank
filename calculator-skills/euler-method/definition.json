    {
      "chapter": "start",
      "spoken": "Estimate y at x equals one in two steps. Start at the known point zero, two.",
      "coach": "dy/dx = x − y · h = 0.5",
      "end": 6.88,
      "hold": 1.6,
      "keys": []
    },
    {
      "chapter": "first-slope",
      "spoken": "Use the starting pair for the slope: zero minus two equals minus two. Multiply the slope by the step size.",
      "coach": "y(next) = y + h · slope at (x, y)",
      "end": 16.27,
      "hold": 1.6,
      "keys": []
    },
    {
      "chapter": "first-update",
